# Copiá estas variables en Vercel → Settings → Environment Variables.
# Con VITE_DEMO_MODE=true el frontend funciona SIN backend (datos de ejemplo
# en el navegador). Si ya desplegaste el backend en Railway, dejá el modo
# demo en false y poné la URL real en VITE_API_URL.
VITE_DEMO_MODE=true
VITE_API_URL=https://tu-backend.up.railway.app
